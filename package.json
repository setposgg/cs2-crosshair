	"description": "CS2 crosshair share codes, pixel geometry and grenade line-up reticle",
	"keywords": [
		"cs2",
		"counter-strike-2",
		"counter-strike",
		"csgo",
		"crosshair",
		"share-code",
		"crosshair-code",
		"grenade",
		"svg",
		"canvas"
	],
	"type": "module",
	"license": "MIT",
	"author": "setpos.gg <hey@lorem.sh> (https://setpos.gg)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/setposgg/cs2-crosshair.git"
	},
	"homepage": "https://setpos.gg",
	"bugs": "https://github.com/setposgg/cs2-crosshair/issues",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
